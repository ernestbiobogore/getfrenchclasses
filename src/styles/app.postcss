@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
	/* Headings */
	h1 {
		@apply text-[2.5rem]/[2.75rem] -tracking-[0.175rem] md:text-[4.375rem]/[5.25rem] font-medium md:-tracking-[0.25rem];
	}

	h2 {
		@apply text-2xl/[2.1rem] -tracking-[0.15rem] font-medium md:text-[2.75rem]/[3.3rem] md:-tracking-[0.1rem];
	}

	h3 {
		@apply text-2xl/[2.275rem] sm:text-[1.75rem]/[2.275rem] -tracking-[0.1rem];
	}

	/* Paragraphs */
	p {
		@apply text-base leading-[1.6875rem] -tracking-[0.03rem];
	}
}

@layer components {
	/* Actions */
	.action {
		@apply flex items-center justify-center px-6 py-3 text-xs font-medium rounded-lg;
	}

	.action-base {
		@apply text-white bg-gray-900 action;
	}

	/* Containers */
	.container-base {
		@apply px-4 mx-auto max-w-7xl;
	}

	.container-sm {
		@apply max-w-5xl px-4 mx-auto;
	}
}

.close {
	@apply absolute right-1.5 top-1.5 flex h-7 w-7 items-center justify-center rounded-full;
	@apply bg-white p-0 text-sm font-medium;
}
